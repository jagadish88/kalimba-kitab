@title: Aalo Aamar Aalo Ogo
@subtitle: Kalimba tab -- retune 4 and 4' to F#
@retune: F:F#
@margin: 1.2cm
@beat: 1.8em
@wordgap: .55em
@linegap: .6em
@stanzagap: .9em

(Aa: 5/)(lo: 5) (aa: 5// 4//)(mar: 5) (aa: 6/)(lo: 6) (o: 5/)(go: 6)
(aa: 7/)(lo: 7) (bhu: 1'/)(ban: 2') (bha: 3'/)(ra: 4'.-)
(Aa: 3'/)(lo: 4') (na: 5'/)(yon: 4') (dho: 3'/)(wa: 2'/ 3'// 2'//) (aa: 1'/)(mar: 7/. 1'//)
(aa: 7/)(lo: 6) (hri: 7/)(doy: 7/. 2'//) (ha: 1'/)(ra: 7.-) :||

(Naa: 2'/)(che: 2') (aa: 3'/)(lo: 3') (naa: 4'/)(che: 4') (o: 4'/) (bhaai: 4')
(aa: 2'/)(mar: 2') (praa: 3'/)(ner: 4') (kaa: 4'/)(chhe: 5'.-)
(Baa: 7'/)(je: 7') (aa: 7'/)(lo: 7') (baa: 1''/)(je: 7') (o: 6'/) (bhaai: 6')
(hri: 5'/)(doy: 4')(bee: 2'/)(nar: 3') (maa: 6'/)(jhe: 5'.-)
(Jaa: 7'/)(ge: 7') (aa: 6'/)(kash: 6') (cho: 5'/)(te: 5') (baa: 4'/)(tas: 4')
(haa: 3'/)(se: 3') (sa: 2'/)(kol: 2') (dha: 1'/)(ra: 7.-)

(Aa: 5/)(lo: 5) (aa: 5// 4//)(mar: 5) (aa: 6/)(lo: 6) (o: 5/)(go: 6)
(aa: 7/)(lo: 7) (bhu: 1'/)(ban: 2') (bha: 3'/)(ra: 4'.-)
(Aa: 3'/)(lo: 4') (na: 5'/)(yon: 4') (dho: 3'/)(wa: 2'/ 3'// 2'//) (aa: 1'/)(mar: 7/. 1'//)
(aa: 7/)(lo: 6) (hri: 7/)(doy: 7/. 2'//) (ha: 1'/)(ra: 7.-)

(Aa: 2'/)(lor: 2') (sro: 1'/)(te: 2'/. 1'//) (paal: 2'/. 4'//) (tu: 4'/)(le: 3'/)(chhe: 3')
(haa: 2'/)(jar: 1') (pro: 7/)(ja: 6/ 7// 1'//)(po: 1'/)(ti: 7.-)
(Aa: 5// 7//)(lor: 7) (dheu: 7/)(ye: 7/. 6//) (uth: 6/. 2'//)(lo: 2'/) (me: 1'/)(te: 1')
(mol: 7)(li: 7/)(ka: 6/) (maa: 6/. 1'//)(lo: 1'/)(ti: 7.-) :||

(Me: 2'/)(ghe: 2') (me: 3'/)(ghe: 3') (so: 4'/)(na: 4') (o: 4'/) (bhaai: 4'/. 2'//)
(jaay: 2') (na: 2'/) (maa: 3'/)(nik: 4') (go: 4'/)(na: 5'.-)
(Paa: 5'// 7'//)(tay: 7') (paa: 7'/)(tay: 7') (haa: 1''/)(si: 7') (o: 6'/) (bhaai: 6')
(pu: 5'/)(lok: 4') (raa: 2'/)(shi: 3') (raa: 3'// 6'//)(shi: 5'.-)
(Su: 5'// 7'//)(ro: 7')(no: 6'/)(dir: 6') (kul: 5') (du: 5'/)(be: 4'/)(chhe: 4')
(su: 3'/)(dha: 3') (ni: 2'/)(jhar: 2'// 1'/ 2'//) (jha: 1'/)(ra: 7.-)

(Aa: 5/)(lo: 5) (aa: 5// 4//)(mar: 5) (aa: 6/)(lo: 6) (o: 5/)(go: 6)
(aa: 7/)(lo: 7) (bhu: 1'/)(ban: 2') (bha: 3'/)(ra: 4'.-)
(Aa: 3'/)(lo: 4') (na: 5'/)(yon: 4') (dho: 3'/)(wa: 2'/ 3'// 2'//) (aa: 1'/)(mar: 7/. 1'//)
(aa: 7/)(lo: 6) (hri: 7/)(doy: 7/. 2'//) (ha: 1'/)(ra: 7.-)
