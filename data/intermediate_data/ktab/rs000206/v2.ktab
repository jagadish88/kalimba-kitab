(A: 2')(ma: 3')(ro: 2') (po: 1')(ra: 7)(no: 6) (ja: 7)(ha: 6/ 5/) (chay: 6---)
(Tu: 6)(mi: 3') (taai: 2'/ 3'.---)
(Tu: 3'/ 4')(mi: 4'/) (taai: 2' 3'--) (go: 1'- 7/ 6/ 7)
(A: 2')(ma: 3')(ro: 2') (po: 1')(ra: 7)(no: 6) (ja: 7)(ha: 6/ 5/) (chay: 6---)

(To: 2')(ma: 3') (chha: 3')(ra: 3') (aar: 3'-) (e: 4') (ja: 3')(go: 2'-)(te: 3'.--)
(Mor: 2' 3') (ke: 2')(ho: 3') (naai: 5'/ 6'--)
(ki: 5'/)(chu: 4'/ 3') (naai: 2' 3'--) (go: 1'- 7/ 6/ 7-)

(Tu: 3')(mi: 3') (shu: 2')(kho: 3') (jo: 3' 5')(di: 5'-)
(naa: 4')(hi: 5') (paao: 6'-- 5' 6'-)
(Jaao: 6'-) (shu: 5')(khe: 6')(ro: 7') (san: 7' 7')(dha: 1'')(ne: 7' 6')
(jaao: 5' 6'-- 4' 5'.--)

(Aa: 3')(mi: 3') (to: 2')(ma: 3')(re: 3') (pe: 3'.-)(ye: 3')(chi: 4')
(hri: 2' 3')(da: 3')(yo: 5' 5')(maa: 5')(jhe: 6'-)
(Aar: 5' 7' 6') (ki: 5' 4'/)(chu: 6'/ 5')
(naa: 4')(hi: 3') (chaai: 2' 3'--) (go: 1'- 7/ 6/ 7--)

(Aa: 6)(mi: 6) (to: 4')(ma: 4')(ro: 4') (bi: 4' 4')(ra: 5')(he: 4' 3')
(ro: 2')(hi: 3')(bo: 3') (bi: 3' 3'-)(lin: 3'-)
(To: 2')(ma: 3')(te: 4') (ko: 4' 4')(ri: 5')(bo: 4' 3') (baas: 2'--- 1'---)

(Dir: 1'.)(gho: 2'/ 2') (di: 2')(ba: 7-)(so: 6-)
(dir: 7.)(gho: 6/ 6) (ra: 7)(ja: 5-)(ni: 6-)
(Dir: 7.)(gho: 2'/ 2') (ba: 2')(ra: 3'-)(so: 4' 3') (maas: 3'---)
