# Legacy folders (their essentials were copied into data/, scripts/ and src/)
/songs/
/video/

# Third-party files: listed in sources/sources.csv, re-downloaded with scripts/fetch_sources.py
data/raw_data/midi/*.mid
data/raw_data/swaralipi/
data/raw_data/text/lyrics/
# Local reference PDFs (not tracked, not catalogued)
data/raw_data/text/pdf/

# Downloaded videos (listed in data/raw_data/video/video_catalog.csv)
data/raw_data/video/*.mp4

# Python and LaTeX leftovers
__pycache__/
*.egg-info/
*.aux
*.log

# Downloaded audio (vocal references, recordings)
data/raw_data/audio/*
!data/raw_data/audio/.gitkeep
data/intermediate_data/vocal_melody/**/*_vocals.wav

# Rendered draft videos and their intro slides (re-made with scripts/ktab_to_video/)
data/intermediate_data/**/*.mp4
data/intermediate_data/**/*_slide.png


# SNLTR's notation tables as saved from their site (not for re-hosting); our transcription
# of them is data/intermediate_data/swaralipi/ (scripts/swaralipi_player/notation.py)
data/raw_data/swaralipi_text/
